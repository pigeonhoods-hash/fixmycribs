MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=fixmycribs
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
APP_ENV=development
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace_with_a_strong_password
ADMIN_SEED_NAME=FixMyCribs Administrator
ADMIN_SEED_PHONE=
# On Railway Hobby use Resend over HTTPS (SMTP outbound is blocked):
RESEND_API_KEY=
EMAIL_FROM=noreply@your-verified-domain.com
EMAIL_FROM_NAME=FixMyCribs
# SMTP alternative (Railway Pro+ only):
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FixMyCribs
# Payment gateway (Paystack, charges NGN via hosted checkout):
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
# Production requires APP_ENV=production, PAYMENT_PROVIDER=paystack,
# Paystack live secret key. Payments provide 30 days of access (manual renewal).
# Optional AI features:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
